# Copy to .env and fill in. .env is gitignored, never commit real keys.
GOOGLE_API_KEY=
# Optional model for src/summarize.py. Defaults to gemini-3.5-flash-lite.
GEMINI_MODEL=
HUGGINGFACEHUB_API_TOKEN=
# Optional: which LLM summarize.py uses. gemini (default), groq, or ollama.
LLM_PROVIDER=
# For LLM_PROVIDER=groq. Key from https://console.groq.com/keys
GROQ_API_KEY=
# Optional Groq model. Defaults to openai/gpt-oss-120b.
GROQ_MODEL=
